# Ambiente da aplicacao: development | production | test
NODE_ENV=development

# Porta HTTP local. No Heroku a porta e injetada automaticamente.
PORT=3000

# String de conexao do PostgreSQL.
# Local:  postgres://postgres:postgres@localhost:5432/kaka_trufas
# Heroku: preenchida automaticamente pelo add-on Heroku Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kaka_trufas

# Segredo usado para assinar o JWT. Gere um valor longo e aleatorio.
# Exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Duracao do token de acesso (ex.: 3600s, 12h, 7d).
JWT_EXPIRES_IN=12h

# Origens permitidas pelo CORS, separadas por virgula.
# Desenvolvimento: http://localhost:5173
# Producao:        https://juliowk.github.io
CORS_ORIGIN=http://localhost:5173

# Credenciais do unico administrador. Usadas apenas na primeira inicializacao
# para criar o usuario; a senha e gravada como hash bcrypt.
ADMIN_EMAIL=admin@gamil.com
ADMIN_PASSWORD=0206
